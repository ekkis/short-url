#!/sbin/openrc-run

name="short-url"
description="URL Shortener Service"

command="/usr/bin/node"
command_args="/var/www/short-url/server.js"
command_user="shorturl:shorturl"
directory="/var/www/short-url"

# Keep a service-specific pidfile separate from any legacy short-url state.
pidfile="/run/short-url/short-url.pid"

command_background=true

# Environment variables
export PORT=3000
export BASE_URL=https://ekkis.id
export DB_PATH=/var/lib/short-url/urls.db

# Service dependencies
depend() {
    need net
    after firewall
}

# Pre-start checks
start_pre() {
    checkpath -d -m 0755 -o shorturl:shorturl /run/short-url
    checkpath -d -o shorturl:shorturl /var/lib/short-url
}
