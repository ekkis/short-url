#!/sbin/openrc-run

name="short-url"
description="URL Shortener Service"

# Use env as the supervised command so OpenRC does not mistake another
# Node.js process for this service when matching the executable.
command="/usr/bin/env"
command_args="NODE_ENV=production /usr/bin/node /var/www/short-url/server.js"
command_user="shorturl:shorturl"
directory="/var/www/short-url"

pidfile="/run/${RC_SVCNAME}.pid"

# supervise-daemon matches this service by its command and pidfile, avoiding
# collisions with other Node.js applications on the host.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
output_log="/var/log/short-url.log"
error_log="/var/log/short-url.log"

# Environment variables
export PORT=3000
export BASE_URL=https://ekkis.id
export DB_PATH=/var/lib/short-url/urls.db

# Service dependencies
depend() {
    need net
    after firewall
}

# Pre-start checks
start_pre() {
    checkpath -d -o shorturl:shorturl /run
    checkpath -d -o shorturl:shorturl /var/lib/short-url
}
